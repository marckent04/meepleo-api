{
  "name": "meeploe-api-ts",
  "version": "0.0.1",
  "description": "Meepleo REST API (NestJS + CQRS + Prisma)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "lint-and-format": "biome check --write",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate && prisma format --check",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fastify/static": "^10.1.9",
    "@nestjs-cls/transactional": "^4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "^2.0.2",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12",
    "@nestjs/cqrs": "^12",
    "@nestjs/platform-fastify": "^12",
    "@nestjs/swagger": "^12",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-cls": "^7.0.2",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12",
    "@swc/core": "^1.16.21",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "unplugin-swc": "^2.0.0",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
