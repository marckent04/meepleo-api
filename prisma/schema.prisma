// Conventions: singular PascalCase models + @@map("plural_snake_case"),
// camelCase fields + @map("snake_case"), ids String @id @db.Uuid,
// dates DateTime @db.Timestamptz(6). See ARCHITECTURE.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Games and rule sheets
//
// Translated texts: Json columns in the LocalizedText format `{ "fr": "...", "en": "..." }`,
// parsed only in the mappers.
// An empty `playerCounts` = the rule applies to all player configurations.
// ---------------------------------------------------------------------------

enum GameCategory {
  ABSTRACT
  CARD
  CHILDREN
  FAMILY
  PARTY
  STRATEGY
  THEMATIC
  WAR

  @@map("game_category")
}

enum RuleType {
  SETUP // setup
  TURN // steps / actions of a turn
  SPECIAL // special rules
  VARIANT // variants and optional rules chosen by the players
  END_TRIGGER // round / game end triggers
  SCORING // scoring
  WINNER // victory condition
  TIE_BREAKER // tie-breaker

  @@map("rule_type")
}

enum SheetConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("sheet_confidence")
}

enum GameAggregationOperation {
  GENERATION // full generation (web search + extraction)
  TRANSLATION // translation of an existing sheet

  @@map("game_aggregation_operation")
}

enum GameAggregationStatus {
  SUCCESS
  FAILURE
  RUNNING // in progress, in the background; abandoned if it exceeds the maximum delay

  @@map("game_aggregation_status")
}

model Game {
  id                 String         @id @default(uuid(7)) @db.Uuid
  bggId              Int?           @unique @map("bgg_id")
  /// Canonical name (BGG)
  name               String
  localizedNames     Json?          @map("localized_names")
  /// Other titles the game is published under (localized editions, BGG
  /// alternate names), without language; filled by the sheet generation
  alternativeNames   String[]       @default([]) @map("alternative_names")
  /// LocalizedText
  description        Json?
  year               Int?
  designers          String[]
  publisher          String?
  edition            String?
  imageUrl           String?        @map("image_url")
  /// URL of the official rulebook found during the generation
  ruleBookUrl        String?        @map("rule_book_url")
  categories         GameCategory[]
  minPlayers         Int?           @map("min_players")
  maxPlayers         Int?           @map("max_players")
  minAge             Int?           @map("min_age")
  minDuration        Int?           @map("min_duration_minutes")
  maxDuration        Int?           @map("max_duration_minutes")

  // Rule sheet: null until it has been generated.
  /// ISO 639-1 codes of the available languages (e.g. ["fr", "en"]), validated in code
  supportedLanguages String[]         @default([]) @map("supported_languages")
  /// LocalizedText
  turnSummary        Json?            @map("turn_summary")
  /// LocalizedText
  endTiming          Json?            @map("end_timing")
  sheetConfidence    SheetConfidence? @map("sheet_confidence")
  /// Array<{ title: string, url: string }>
  sheetSources       Json?            @map("sheet_sources")
  /// LocalizedText[]
  sheetWarnings      Json?            @map("sheet_warnings")

  barcodes        GameBarcode[]
  rules           GameRule[]
  /// The sheet is generated as soon as a SUCCESS / GENERATION run exists (date and model of the latest one).
  aggregationRuns GameAggregationRun[]
  catalogEntries  UserGame[]
  favoritedBy     UserFavorite[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([name])
  @@map("games")
}

model GameBarcode {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// EAN / UPC
  code      String   @unique
  gameId    String   @map("game_id") @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gameId])
  @@map("game_barcodes")
}

/// Barcodes the external lookup could not resolve: never looked up again.
/// Technical cache (no soft delete), purged by hard delete.
model BarcodeLookupMiss {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// EAN / UPC
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("barcode_lookup_misses")
}

model GameRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type         RuleType
  /// Not unique: several alternatives depending on the player count can share an order.
  order        Int
  /// Display rank among rules of the same type (breaks ties between equal orders)
  position     Int      @default(0)
  /// [] = all players
  playerCounts Int[]    @map("player_counts")
  optional     Boolean  @default(false)
  /// LocalizedText
  title        Json?
  /// LocalizedText
  text         Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([gameId, type, position])
  @@map("game_rules")
}

/// Sheet aggregation attempt (generation or translation), in progress, successful or not:
/// duration, model, usage and raw AI output, kept for analysis.
/// Created RUNNING at launch (createdAt = start), then moved to SUCCESS or FAILURE.
model GameAggregationRun {
  id                       String                    @id @default(uuid(7)) @db.Uuid
  gameId                   String                    @map("game_id") @db.Uuid
  game                     Game                      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status                   GameAggregationStatus
  /// ISO 639-1 code of the requested language
  language                 String
  /// null if the failure occurred before the AI call (lock, database…)
  operation                GameAggregationOperation?
  /// Source language of a translation
  sourceLanguage           String?                   @map("source_language")
  /// AI model (e.g. "claude-haiku-5-5"), null without an AI call
  model                    String?
  /// Total duration of the operation (AI calls + saving), in ms; 0 while RUNNING
  durationMs               Int                       @map("duration_ms")
  /// Accumulated duration of the AI calls, in ms
  aiDurationMs             Int?                      @map("ai_duration_ms")
  /// Number of API calls (pause_turn retries included)
  requestCount             Int?                      @map("request_count")
  /// Usage accumulated over all calls
  inputTokens              Int?                      @map("input_tokens")
  outputTokens             Int?                      @map("output_tokens")
  cacheCreationInputTokens Int?                      @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int?                      @map("cache_read_input_tokens")
  webSearchRequests        Int?                      @map("web_search_requests")
  webFetchRequests         Int?                      @map("web_fetch_requests")
  /// stop_reason of the last response
  stopReason               String?                   @map("stop_reason")
  /// Fingerprint of the system prompt and the output schema
  promptVersion            String?                   @map("prompt_version")
  /// Call parameters: { effort, maxTokens, tools }
  settings                 Json?
  /// Raw structured output of the AI
  output                   Json?
  /// Raw response text when the structured output could not be read
  rawText                  String?                   @map("raw_text")
  /// ErrorCode of the AppError, otherwise INTERNAL_SERVER_ERROR
  errorCode                String?                   @map("error_code")
  errorMessage             String?                   @map("error_message")
  /// Technical context (AppError.details, secrets masked)
  errorDetails             Json?                     @map("error_details")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gameId, createdAt])
  @@index([gameId, operation, status, createdAt])
  @@index([status, createdAt])
  @@map("game_aggregation_runs")
}

// ---------------------------------------------------------------------------
// Authentication
//
// `email` and `username` are stored normalized (lowercase): uniqueness and
// login are therefore case-insensitive. Refresh tokens are never
// stored in clear, only their SHA-256 fingerprint.
// ---------------------------------------------------------------------------

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  email         String         @unique
  username      String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]
  catalog       UserGame[]
  favorites     UserFavorite[]

  @@map("users")
}

model RefreshToken {
  /// Token identifier (`jti` claim of the JWT)
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 fingerprint of the refresh token
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set on rotation or sign-out; a revoked token presented again signals a theft
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Status of a game for a user: in their library or in their wishlist
enum UserGameStatus {
  OWNED // owned (library)
  WISHLIST // wished for, not owned

  @@map("user_game_status")
}

/// Game linked to a user: library or wishlist (never both)
model UserGame {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String         @map("game_id") @db.Uuid
  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status    UserGameStatus @default(OWNED)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, gameId])
  @@index([userId, status])
  @@map("user_games")
}

/// Game favorited by a user
model UserFavorite {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String   @map("game_id") @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, gameId])
  @@index([userId])
  @@map("user_favorites")
}
