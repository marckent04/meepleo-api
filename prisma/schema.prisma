// Conventions : modèles PascalCase singulier + @@map("snake_case_pluriel"),
// champs camelCase + @map("snake_case"), ids String @id @db.Uuid,
// dates DateTime @db.Timestamptz(6). Voir ARCHITECTURE.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Jeux et fiches de règles
//
// Textes traduits : colonnes Json au format LocalizedText `{ "fr": "...", "en": "..." }`,
// parsées uniquement dans les mappers.
// `playerCounts` vide = la règle s'applique à toutes les configurations de joueurs.
// ---------------------------------------------------------------------------

enum GameCategory {
  ABSTRACT
  CARD
  CHILDREN
  FAMILY
  PARTY
  STRATEGY
  THEMATIC
  WAR

  @@map("game_category")
}

enum RuleType {
  SETUP // mise en place
  TURN // étapes / actions d'un tour
  SPECIAL // règles spéciales
  END_TRIGGER // déclencheurs de fin de manche / partie
  SCORING // décompte
  WINNER // condition de victoire
  TIE_BREAKER // départage

  @@map("rule_type")
}

enum SheetConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("sheet_confidence")
}

enum GameAggregationOperation {
  GENERATION // génération complète (recherche web + extraction)
  TRANSLATION // traduction d'une fiche existante

  @@map("game_aggregation_operation")
}

enum GameAggregationStatus {
  SUCCESS
  FAILURE
  RUNNING // en cours, en tâche de fond ; abandonné s'il dépasse le délai maximal

  @@map("game_aggregation_status")
}

model Game {
  id                 String         @id @default(uuid(7)) @db.Uuid
  bggId              Int?           @unique @map("bgg_id")
  /// Nom canonique (BGG)
  name               String
  /// LocalizedText
  localizedNames     Json?          @map("localized_names")
  /// LocalizedText
  description        Json?
  year               Int?
  designers          String[]
  publisher          String?
  edition            String?
  imageUrl           String?        @map("image_url")
  /// URL de la règle officielle trouvée lors de la génération
  ruleBookUrl        String?        @map("rule_book_url")
  categories         GameCategory[]
  minPlayers         Int?           @map("min_players")
  maxPlayers         Int?           @map("max_players")
  recommendedPlayers Int[]          @map("recommended_players")
  minAge             Int?           @map("min_age")
  minDuration        Int?           @map("min_duration_minutes")
  maxDuration        Int?           @map("max_duration_minutes")

  // Fiche de règles : null tant qu'elle n'a pas été générée.
  /// Codes ISO 639-1 des langues disponibles (ex. ["fr", "en"]), validés dans le code
  supportedLanguages String[]         @default([]) @map("supported_languages")
  /// LocalizedText
  turnSummary        Json?            @map("turn_summary")
  /// LocalizedText
  endTiming          Json?            @map("end_timing")
  sheetConfidence    SheetConfidence? @map("sheet_confidence")
  /// Array<{ title: string, url: string }>
  sheetSources       Json?            @map("sheet_sources")
  /// LocalizedText[]
  sheetWarnings      Json?            @map("sheet_warnings")

  barcodes        GameBarcode[]
  rules           GameRule[]
  /// La fiche est générée dès qu'un run SUCCESS / GENERATION existe (date et modèle du plus récent).
  aggregationRuns GameAggregationRun[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([name])
  @@map("games")
}

model GameBarcode {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// EAN / UPC
  code      String   @unique
  gameId    String   @map("game_id") @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gameId])
  @@map("game_barcodes")
}

model GameRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type         RuleType
  /// Non unique : plusieurs alternatives selon le nombre de joueurs peuvent partager un ordre.
  order        Int
  /// Rang d'affichage parmi les règles du même type (départage les ordres égaux)
  position     Int      @default(0)
  /// [] = tous les joueurs
  playerCounts Int[]    @map("player_counts")
  optional     Boolean  @default(false)
  /// LocalizedText
  title        Json?
  /// LocalizedText
  text         Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([gameId, type, position])
  @@map("game_rules")
}

/// Tentative d'agrégation de fiche (génération ou traduction), en cours, réussie ou non :
/// durée, modèle, consommation et sortie brute de l'IA, conservées pour analyse.
/// Créée RUNNING au lancement (createdAt = début), puis passée SUCCESS ou FAILURE.
model GameAggregationRun {
  id                       String                    @id @default(uuid(7)) @db.Uuid
  gameId                   String                    @map("game_id") @db.Uuid
  game                     Game                      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status                   GameAggregationStatus
  /// Code ISO 639-1 de la langue demandée
  language                 String
  /// null si l'échec est survenu avant l'appel à l'IA (verrou, base de données…)
  operation                GameAggregationOperation?
  /// Langue source d'une traduction
  sourceLanguage           String?                   @map("source_language")
  /// Modèle d'IA (ex. "claude-haiku-5-5"), null sans appel à l'IA
  model                    String?
  /// Durée totale de l'opération (appels IA + enregistrement), en ms ; 0 tant que RUNNING
  durationMs               Int                       @map("duration_ms")
  /// Durée cumulée des appels à l'IA, en ms
  aiDurationMs             Int?                      @map("ai_duration_ms")
  /// Nombre d'appels à l'API (relances pause_turn comprises)
  requestCount             Int?                      @map("request_count")
  /// Consommation cumulée sur tous les appels
  inputTokens              Int?                      @map("input_tokens")
  outputTokens             Int?                      @map("output_tokens")
  cacheCreationInputTokens Int?                      @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int?                      @map("cache_read_input_tokens")
  webSearchRequests        Int?                      @map("web_search_requests")
  webFetchRequests         Int?                      @map("web_fetch_requests")
  /// stop_reason de la dernière réponse
  stopReason               String?                   @map("stop_reason")
  /// Empreinte du prompt système et du schéma de sortie
  promptVersion            String?                   @map("prompt_version")
  /// Paramètres d'appel : { effort, maxTokens, tools }
  settings                 Json?
  /// Sortie structurée brute de l'IA
  output                   Json?
  /// Texte brut de la réponse quand la sortie structurée n'a pas pu être lue
  rawText                  String?                   @map("raw_text")
  /// ErrorCode de l'AppError, sinon INTERNAL_SERVER_ERROR
  errorCode                String?                   @map("error_code")
  errorMessage             String?                   @map("error_message")
  /// Contexte technique (AppError.details, secrets masqués)
  errorDetails             Json?                     @map("error_details")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gameId, createdAt])
  @@index([gameId, operation, status, createdAt])
  @@index([status, createdAt])
  @@map("game_aggregation_runs")
}
