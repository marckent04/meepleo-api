NODE_ENV=development
PORT=3000

# DATABASE (Prisma)
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
DB_POOL_MAX=10

POSTGRES_PORT=5432
LOG_LEVELS=info,warn,error,fatal

# ANTHROPIC (rule sheet generation)
ANTHROPIC_API_KEY=
ANTHROPIC_SHEET_MODEL=claude-haiku-5-5
# Sheet generation effort: low | medium | high (default medium)
ANTHROPIC_SHEET_EFFORT=medium
ANTHROPIC_SHEET_TRANSLATION_MODEL=claude-haiku-5-5

# AUTH (JWT): two distinct secrets of at least 32 characters
# (ex. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations: seconds or s/m/h/d suffix
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
