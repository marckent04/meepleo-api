NODE_ENV=development
PORT=3000

# DATABASE (Prisma)
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
DB_POOL_MAX=10

POSTGRES_PORT=5432
LOG_LEVELS=info,warn,error,fatal

# ANTHROPIC (génération des fiches de règles)
ANTHROPIC_API_KEY=
ANTHROPIC_SHEET_MODEL=claude-haiku-5-5
# Effort de génération des fiches : low | medium | high (défaut medium)
ANTHROPIC_SHEET_EFFORT=medium
ANTHROPIC_SHEET_TRANSLATION_MODEL=claude-haiku-5-5

# AUTH (JWT) : deux secrets distincts d'au moins 32 caractères
# (ex. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durées : secondes ou suffixe s/m/h/d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
