# Local configuration, read by `make`. Copy to .env (never commit .env).
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
# Host ports of docker-compose; change them if they are taken on your machine
# (and update the two URLs below).
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://meepleo:meepleo@localhost:5432/meepleo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Local-only secret. Generate a real one with: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-0123456789
DOCS_ENABLED=true
# Needed by the worker only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GENERATION_DAILY_BUDGET=50
# OpenTelemetry: leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
